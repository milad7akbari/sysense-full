generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id          Int      @id @default(autoincrement())
  title       String?
  description String?
  imageUrl    String

  width       Int      @default(0)
  height      Int      @default(0)

  categories   Category[]     @relation("ProductCategories")

  images       ProductImage[]

  brandId      Int?
  brand        Brand?         @relation(fields: [brandId], references: [id])

  boardId     Int?
  board       Board?   @relation(fields: [boardId], references: [id])

  userId      Int
  user        User     @relation(fields: [userId], references: [id])

  likes       Like[]
  likesCount  Int      @default(0)

  active       Boolean        @default(true)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductImage {
  id        Int     @id @default(autoincrement())
  url       String
  productId Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Like {
  id        Int      @id @default(autoincrement())

  userId    Int
  user      User     @relation(fields: [userId], references: [id])

  productId Int
  product   Product  @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())

  @@unique([userId, productId])
}

model Brand {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  products Product[]
}

model Category {
  id        Int        @id @default(autoincrement())
  name      String
  parentId  Int?
  parent    Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children  Category[] @relation("SubCategories")

  products  Product[]  @relation("ProductCategories")
}

// Comprehensive User Model
model User {
  id              Int       @id @default(autoincrement())
  phoneNumber     String    @unique // Primary login identifier (Required)
  email           String?   @unique
  firstName       String?
  lastName        String?
  gender          String?   // User's gender (e.g., 'male', 'female', 'other')
  dateOfBirth     DateTime? // User's date of birth (for style suggestions by age)
  bio             String?
  avatar          String?

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relationships
  boards          Board[]
  products        Product[]
  likes           Like[]
}

// Dedicated table for tracking OTP requests (renamed for clarity and includes 'used' field)
model OtpRequests {
  id              Int      @id @default(autoincrement())
  phoneNumber     String   @unique // The phone number the code belongs to
  code            String   // The 5-digit OTP code
  used            Boolean  @default(false) // New field to prevent replay attacks
  expiresAt       DateTime // Time when the OTP becomes invalid

  createdAt       DateTime @default(now())
}


// Board Model (for future use)
model Board {
  id           Int      @id @default(autoincrement())
  title        String
  isPrivate    Boolean  @default(false)

  // Foreign Key to User
  userId       Int
  user         User     @relation(fields: [userId], references: [id])
  products     Product[]
}